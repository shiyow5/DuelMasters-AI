{
  "name": "@dm-ai/agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.eval.json",
    "eval": "tsx eval/run.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dm-ai/core": "workspace:*",
    "@dm-ai/db": "workspace:*",
    "@dm-ai/deck-engine": "workspace:*",
    "@dm-ai/rag": "workspace:*",
    "@langchain/core": "^1.3.5",
    "@langchain/google-genai": "^2.3.5",
    "@langchain/langgraph": "^1.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
